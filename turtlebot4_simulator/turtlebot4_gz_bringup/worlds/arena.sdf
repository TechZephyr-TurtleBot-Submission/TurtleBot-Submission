<?xml version='1.0' encoding='ASCII'?>
<sdf version='1.7'>
  <world name='arena'>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins updated for ROS 2 Jazzy (Gazebo Harmonic) -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system" />
    
    <!-- Sensors plugin commented out to drastically reduce GPU/CPU load (mirrors warehouse.sdf) -->
    <!-- <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
        <render_engine>ogre2</render_engine>
    </plugin> -->

    <!-- Scene Lighting & Environment -->
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>

    <!-- Ground Plane -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Boundary Walls (10m x 10m enclosure) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Static Obstacles -->
    <model name="obstacle_O1_cylinder">
      <static>true</static>
      <pose>-3 3 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_O2_box">
      <static>true</static>
      <pose>2.5 3 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.8 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.8 0.8</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_O3_box">
      <static>true</static>
      <pose>-0.5 1.2 0.3 0 0 0.2</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 0.5 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 0.5 0.6</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_O4_box">
      <static>true</static>
      <pose>-3 -3 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.9 0.9 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.9 0.9 0.7</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_O5_cylinder">
      <static>true</static>
      <pose>1 -3 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- O6 Polygon replacement (primitive cylinder to ensure stability) -->
    <model name="obstacle_O6_cylinder">
      <static>true</static>
      <pose>3.2 -1 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.55</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.55</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.6 0.3 0.3 1</ambient><diffuse>0.6 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>